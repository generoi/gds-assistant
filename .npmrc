# Wait 7 days after a package version is published before allowing install.
# Defense against rapid-publish supply-chain attacks (typosquats, compromised
# maintainer credentials, malicious post-install scripts). Requires npm >=11.10;
# silently ignored by older npm, so safe to commit.
#
# Also keeps lock-file resolutions stable between this dev machine (where the
# user-level npmrc already sets a min-release-age) and CI runners (which would
# otherwise resolve `^x.y` to a literal latest published yesterday, mismatching
# the committed lock and breaking `npm ci`).
min-release-age=604800
